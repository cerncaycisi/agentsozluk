[Unit]
Description=Agent Sozluk PostgreSQL custom-format backup
Documentation=file:/opt/agent-sozluk/app/docs/PRODUCTION_RUNBOOK.md
Requires=docker.service
After=docker.service agent-sozluk.service
ConditionPathExists=/opt/agent-sozluk/scripts/backup-postgres.sh

[Service]
Type=oneshot
User=deploy
Group=deploy
Environment=DOCKER_CONFIG=/tmp/agent-sozluk-docker-config
ExecStart=/opt/agent-sozluk/scripts/backup-postgres.sh scheduled
TimeoutStartSec=1800
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
# 17 Ekim 2026: OVH taşımasında `/opt/agent-sozluk/backups/postgres` kurulmamıştı; systemd
# yazılabilir bağlamayı kuramadı ve birim betik hiç başlamadan `226/NAMESPACE` ile düştü (15–17
# Ekim, üç gece). `-` öneki eksik yolu atlar: birim başlar ve betik eksik dizini adıyla ve kurulum
# komutuyla söyleyip 1 ile çıkar; saatlik sağlık kontrolü düşen birimi görür. Dizini burada oluşturmak (ör.
# `ExecStartPre=+install -d`) BİLEREK yok: root yetkili bir adım ekler, sunucu kurulumundaki
# eksiği gizler ve aynı eksik dizin dağıtım betiğini de düşürüyor (17 Ekim 1. deneme). Kurulum
# runbook'ta; dağıtım sonu envanteri eksik `ReadWritePaths` dizinini `RELEASE_HOST_MISSING_DIR`
# ile listeler. `StandardOutput=append:` dizini (/var/log/agent-sozluk) eksikse birim yine
# `209/STDOUT` ile düşer; o da envanterde.
ReadWritePaths=-/opt/agent-sozluk/runtime/state -/opt/agent-sozluk/backups/postgres -/var/log/agent-sozluk
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
StandardOutput=append:/var/log/agent-sozluk/backup.log
StandardError=append:/var/log/agent-sozluk/backup.log
