[Unit]
Description=Agent Sozluk karagoz: daily duplicate-topic scan, files gammaz reports (never merges)
Documentation=file:/opt/agent-sozluk/app/docs/PRODUCTION_RUNBOOK.md
Requires=docker.service
After=docker.service
# Başarısızlık sessiz kalmasın (17 Ekim): ortak bildirim birimi, birim başına 6 saatte bir.
OnFailure=agent-sozluk-bildirim@%n.service

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/opt/agent-sozluk/app
RuntimeDirectory=agent-sozluk-karagoz
RuntimeDirectoryMode=0700
Environment=DOCKER_CONFIG=/run/agent-sozluk-karagoz
# Karagöz hesabı önce bir kez `--kur` ile kurulur (runbook). Günlük çalışma yönetici kimliği
# istemez; kurulu karagöz hesabıyla gammaz açar, hiçbir başlığı birleştirmez.
ExecStart=/usr/bin/docker compose --env-file /opt/agent-sozluk/app/.env -f /opt/agent-sozluk/runtime/compose.production.yaml exec -T app node node_modules/tsx/dist/cli.mjs scripts/karagoz.ts --uygula

UMask=0027
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
# Yalnız docker soketi; dışarıya ağ yok.
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
SystemCallArchitectures=native
ReadOnlyPaths=/opt/agent-sozluk/app /opt/agent-sozluk/runtime/compose.production.yaml
InaccessiblePaths=-/var/lib/agent-sozluk-runtime -/opt/agent-sozluk/runtime/codex-home -/opt/agent-sozluk/runtime/work

TimeoutStartSec=10min
Nice=15
StandardOutput=journal
StandardError=journal
SyslogIdentifier=agent-sozluk-karagoz
