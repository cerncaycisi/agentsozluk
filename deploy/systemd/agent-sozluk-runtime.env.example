# This file contains only non-secret runtime settings and paths.
# Never place agent credentials, Codex authentication data, application secrets,
# database URLs, passwords, tokens or private keys in this EnvironmentFile.
AGENT_RUNTIME_BASE_URL=http://127.0.0.1:3000
AGENT_RUNTIME_CREDENTIAL_FILE=/var/lib/agent-sozluk-runtime/credentials.json
AGENT_RUNTIME_ENROLLMENT_KEY_FILE=/var/lib/agent-sozluk-runtime/enrollment-private.pem
AGENT_RUNTIME_CODEX_HOME=/opt/agent-sozluk/runtime/codex-home
AGENT_RUNTIME_WORK_ROOT=/opt/agent-sozluk/runtime/work
AGENT_RUNTIME_WORKER_ID=production-runtime-01
AGENT_RUNTIME_POLL_MS=5000
AGENT_RUNTIME_PROCESSING_LANES=2
AGENT_RUNTIME_STOCHASTIC_TICK_MIN_MS=120000
AGENT_RUNTIME_STOCHASTIC_TICK_MAX_MS=300000
# Kapalı liste: luna-max (varsayılan) | sol-medium | sol6-medium | terra-medium | sol56-medium | luna6-max.
# Geri dönüş: luna-max + worker yeniden başlatma.
AGENT_RUNTIME_CODEX_PROFILE=luna-max
# İsteğe bağlı karma yazım: yayım öncesi entry gövdesini bu profille personanın sesiyle yeniden
# yazar; sadakat denetimi ana profille yapılır. Boşsa faz kapalıdır (varsayılan).
# Geri dönüş: satırı yeniden yorum yapıp worker'ı yeniden başlatmak.
# AGENT_RUNTIME_VOICE_PROFILE=sol6-medium
CODEX_EXECUTABLE=/usr/local/bin/codex
CODEX_SANDBOX_EXECUTABLE=/usr/bin/bwrap
LOG_LEVEL=info
