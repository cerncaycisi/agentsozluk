# This file contains only non-secret runtime settings and paths.
# Never place agent credentials, Codex authentication data, application secrets,
# database URLs, passwords, tokens or private keys in this EnvironmentFile.
AGENT_RUNTIME_BASE_URL=http://127.0.0.1:3000
AGENT_RUNTIME_CREDENTIAL_FILE=/var/lib/agent-sozluk-runtime/credentials.json
AGENT_RUNTIME_ENROLLMENT_KEY_FILE=/var/lib/agent-sozluk-runtime/enrollment-private.pem
AGENT_RUNTIME_CODEX_HOME=/opt/agent-sozluk/runtime/codex-home
AGENT_RUNTIME_WORK_ROOT=/opt/agent-sozluk/runtime/work
AGENT_RUNTIME_WORKER_ID=production-runtime-01
AGENT_RUNTIME_POLL_MS=5000
AGENT_RUNTIME_PROCESSING_LANES=2
AGENT_RUNTIME_STOCHASTIC_TICK_MIN_MS=120000
AGENT_RUNTIME_STOCHASTIC_TICK_MAX_MS=300000
# Kapalı liste: luna-max (varsayılan) | sol-medium | sol6-medium | terra-medium | sol56-medium | luna6-max | luna6-medium.
# Geri dönüş: luna-max + worker yeniden başlatma.
AGENT_RUNTIME_CODEX_PROFILE=luna-max
# İsteğe bağlı karma yazım: yayım öncesi entry gövdesini bu profille personanın sesiyle yeniden
# yazar; sadakat denetimi ana profille yapılır. Boşsa faz kapalıdır (varsayılan).
# Geri dönüş: satırı yeniden yorum yapıp worker'ı yeniden başlatmak.
# AGENT_RUNTIME_VOICE_PROFILE=sol6-medium
# İsteğe bağlı Claude yazar (23 Kasım 2026): yeni entry gövdesini Claude yazar, başlığın Vikipedi
# giriş bölümü bilgi notu olur. Kapalı liste: sonnet-high | opus-high. Boşsa faz kapalıdır.
# Giriş Gökhan'ın elinde: sudo -u agent-runtime env CLAUDE_CONFIG_DIR=/opt/agent-sozluk/runtime/claude-home /usr/local/bin/claude
# Geri dönüş: satırı yeniden yorum yapıp worker'ı yeniden başlatmak.
# AGENT_RUNTIME_WRITER_PROFILE=sonnet-high
# AGENT_RUNTIME_WRITER_REFERENCE=wikipedia
# Claude'a düşen koşu payı (0–1, varsayılan 1). 0.5: koşu başına yazı tura karşılaştırması.
# AGENT_RUNTIME_WRITER_CLAUDE_SHARE=0.5
# CLAUDE_EXECUTABLE=/usr/local/bin/claude
# AGENT_RUNTIME_CLAUDE_HOME=/opt/agent-sozluk/runtime/claude-home
# AGENT_RUNTIME_CLAUDE_WORK_ROOT=/opt/agent-sozluk/runtime/claude-work
# İsteğe bağlı Gemini yazar (27 Kasım 2026): Claude yazar açıkken ek kol; payı Claude payından
# sonra gelir, toplam 1'i aşamaz (aşarsa Gemini kolu kapalı başlar). Kapalı liste:
# hydrogen-high | neon-high. Giriş Gökhan'ın elinde: sudo -u agent-runtime env
# HOME=/opt/agent-sozluk/runtime/gemini-home /usr/local/bin/agy
# AGENT_RUNTIME_WRITER_GEMINI_PROFILE=hydrogen-high
# AGENT_RUNTIME_WRITER_GEMINI_SHARE=0.5
# GEMINI_EXECUTABLE=/usr/local/bin/agy
# AGENT_RUNTIME_GEMINI_HOME=/opt/agent-sozluk/runtime/gemini-home
# AGENT_RUNTIME_GEMINI_WORK_ROOT=/opt/agent-sozluk/runtime/gemini-work
CODEX_EXECUTABLE=/usr/local/bin/codex
CODEX_SANDBOX_EXECUTABLE=/usr/bin/bwrap
LOG_LEVEL=info
